playwright-report/

# 原始验收过程输出默认留在本机；概要、截图、复跑脚本与历史压缩包保留
/docs/testing/evidence/**/*.jsonl
/docs/testing/evidence/**/*source-hashes.json
/docs/testing/evidence/**/*build-manifest*.json
/docs/testing/evidence/**/source-input*.json
/docs/testing/evidence/**/pages.json
/docs/testing/evidence/**/execution-inputs.json
/docs/testing/evidence/**/raw.json
/output/acceptance-raw/
/output/evidence-maintenance-*/
# 同类本机验收编译输出落在子包时同样不进入仓库
/apps/api/output/acceptance-raw/

# 本机临时工具、缓存与覆盖率产物
.tmp-*/
.vite/
.cache/
coverage/
*.tsbuildinfo

# preview.html 的原型图自动收录清单，可由 node scripts/preview-gallery.mjs 重新生成
/preview-manifest.js

# 功能地图的本机快照，由 scripts/feature-map.mjs 从现有事实源生成
/output/feature-map/

# 效果图打包件，与同目录原图重复，不进入仓库
/docs/frontend/mockups/**/*.zip

# 可重新生成的验收构建与进程输出；截图、JSON 和复跑脚本保留
/output/*-build/
/output/playwright/agent-audit/*.out
/output/playwright/agent-audit/*.err

# 浏览器自动化测试的临时会话日志与快照
.playwright-cli/

# Local desktop trial package and persistent test data
/test-release/
/.relay-test/

# 本机开发数据库（PostgreSQL 5432/relay_dev，供 dev-stack Preview 与 apps/api/.env 直连）
/.relay-dev/

.superpowers/

# 代理会话导出：opencode `opencode export <id>` 的默认落点是仓库根目录，
# 含完整对话与用量，不进入版本库。需要留档时放到 output/acceptance-raw/
/ses_*.json

# 其他代理工作流在本机留下的记忆目录，不属于本仓库事实源
.workbuddy-ai/
