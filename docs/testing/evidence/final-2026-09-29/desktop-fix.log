+fn supervisor_restart_allowed(consecutive_restarts: u32, supervisor_uptime: Duration) -> bool {
+    supervisor_uptime >= SUPERVISOR_STABILITY_WINDOW || consecutive_restarts < SUPERVISOR_RESTART_LIMIT
