# Place this file at %APPDATA%\dev.relay.agent\desktop.env, or set RELAY_DESKTOP_CONFIG_PATH.
# Use an existing PostgreSQL application-role database and a workspace created by init:workspace.
RELAY_DB_URL=postgresql://relay_app@127.0.0.1:5432/relay_agent
RELAY_DB_POOL_MAX=4
RELAY_DB_CONNECT_TIMEOUT_MS=3000
RELAY_DESKTOP_WORKSPACE_ID=00000000-0000-4000-8000-000000000000

# Optional: real model port (OpenAI-compatible). Omit everything to keep the Mock port.
# The API key stays only in this local file; the host passes it to API/Supervisor/Worker
# via --env-file. It is never stored in the database, shown in the UI, or written to logs.
# RELAY_MODEL_PROVIDER=openai-compatible
# RELAY_MODEL_NAME=
# RELAY_MODEL_API_KEY=
# RELAY_MODEL_BASE_URL=
# RELAY_MODEL_TIMEOUT_MS=120000
# RELAY_MODEL_MAX_OUTPUT_TOKENS=4096
# RELAY_MODEL_MAX_CALL_TOKENS=65536
# RELAY_MODEL_MAX_SCOPE_CALLS=32
# RELAY_MODEL_MAX_SCOPE_TOKENS=262144
