# apps/api 最低启动配置示例。
# 复制为 apps/api/.env（该文件已被 .gitignore 忽略）并填入真实值。
# 缺失或非法的键会让进程以退出码 2 结束，不会静默使用默认值。
# 不要把真实凭据提交到仓库。

# 本机 API 绑定，只接受回环地址 127.0.0.1 或 ::1；端口必须显式给出，被占用即启动失败
RELAY_API_BIND_HOST=127.0.0.1
RELAY_API_PORT=8787

# 显式允许的前端来源，逗号分隔；必须是规范化 origin，不接受 * 或 null
RELAY_API_ALLOWED_ORIGINS=http://127.0.0.1:5173

# 由外部注入的随机 Bearer 凭据：至少 32 字符，不含空白。
# 下面这行是占位符，校验会明确拒绝，必须替换为自行生成的随机值。
RELAY_API_BEARER_TOKEN=replace-with-a-random-credential-of-at-least-32-chars

# 业务数据库连接；示例指向本机独立 PostgreSQL，不连接其他项目或用户数据库。
# 应用角色只持有迁移授予的权限，不能 DDL、不能修改不可变历史表。
# 角色需要先用 sql/bootstrap-roles.sql 建立，且数据库 owner 为 relay_migrator。
RELAY_DB_URL=postgresql://relay_app@127.0.0.1:5432/relay_dev
RELAY_DB_POOL_MAX=4
RELAY_DB_CONNECT_TIMEOUT_MS=2000

# 迁移连接：必须是持有 DDL 的迁移角色，和应用角色分开。
# 只被 `pnpm run migrate` 使用；API 启动本身不执行迁移。
RELAY_MIGRATION_DB_URL=postgresql://relay_migrator@127.0.0.1:5432/relay_dev

# Workspace 初始化入口（`pnpm run init:workspace -- --name "<名称>"`）：
# 名称也可以用 RELAY_WORKSPACE_NAME 提供，二者都不给会以退出码 2 结束。
RELAY_WORKSPACE_NAME=

# 受管数据根目录：绝对路径、必须已存在、必须位于源码仓库之外。
# Artifact 内容也写在这里（staging/<version-id>.part 与 artifacts/<artifact-id>/<version-id>/content.md），
# 路径全部由服务端按内部 ID 生成，不接受任何客户端提供的路径。
RELAY_DATA_ROOT=D:/Relay-Agent-data

# fatal | error | warn | info | debug | trace
RELAY_LOG_LEVEL=info

# true 时，受管启动方关闭本进程 stdin 即触发一次正常退出（关闭 HTTP 与连接池）
RELAY_API_STOP_ON_STDIN_EOF=true